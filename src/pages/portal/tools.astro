---
import Portal from '../../layouts/Portal.astro';
---
<Portal title="Developer Tools | EVAN DEVELOPERS">
<div class="portal-wrap portal-inner-page">
<div class="portal-kicker">DEVELOPER CENTER / UTILITIES</div><h1>Developer Tools</h1><p>설비 자동화 개발자를 위한 브라우저 기반 유틸리티. 입력 데이터는 서버로 전송하지 않습니다.</p>
<nav class="tool-links" aria-label="도구 바로가기"><a href="#hex">HEX Converter</a><a href="#word">Bit &amp; Word</a><a href="#bbl">BBL</a><a href="#ascii">ASCII</a><a href="#pio">PLC Handshake</a></nav>
<div class="tool-grid">
<section class="portal-card tool" id="hex"><div class="portal-kicker">01 / CONVERSION</div><h2>HEX Converter</h2><p>부호 없는 64비트 정수 변환 (접두사 제외).</p><label>입력 진법<select id="hex-base"><option value="10">Decimal</option><option value="16">Hexadecimal</option><option value="2">Binary</option></select></label><label>값<input id="hex-value" value="255" maxlength="64" autocomplete="off"/></label><pre id="hex-result" aria-live="polite"></pre></section>
<section class="portal-card tool" id="word"><div class="portal-kicker">02 / BIT ANALYSIS</div><h2>Bit &amp; Word Analyzer</h2><p>비트를 클릭해 값을 변경할 수 있습니다. Bit 0은 LSB입니다.</p><div class="fields"><label>크기<select id="word-width"><option value="16">16 bit</option><option value="32">32 bit</option></select></label><label>입력 진법<select id="word-base"><option value="16">HEX</option><option value="10">DEC</option><option value="2">BIN</option></select></label></div><label>값<input id="word-value" value="00FF" maxlength="64" autocomplete="off"/></label><div id="bits" class="bit-grid" role="group" aria-label="비트 토글"></div><pre id="word-result" aria-live="polite"></pre></section>
<section class="portal-card tool" id="bbl"><div class="portal-kicker">03 / POSITION</div><h2>BBL Formatter</h2><p>Bank 2자리 · Bay 3자리 · Level 2자리.</p><div class="fields"><label>Bank<input id="bank" inputmode="numeric" value="1" maxlength="2"/></label><label>Bay<input id="bay" inputmode="numeric" value="2" maxlength="3"/></label><label>Level<input id="level" inputmode="numeric" value="1" maxlength="2"/></label></div><pre id="bbl-result" aria-live="polite"></pre><small>위치 문자열 포맷만 검증하며 설비의 실제 위치 범위는 검증하지 않습니다.</small></section>
<section class="portal-card tool" id="ascii"><div class="portal-kicker">04 / ENCODING</div><h2>ASCII Converter</h2><p>7비트 ASCII와 HEX 바이트를 상호 변환합니다.</p><label>방향<select id="ascii-mode"><option value="text">ASCII → HEX</option><option value="hex">HEX → ASCII</option></select></label><label>입력<textarea id="ascii-value" maxlength="4096" rows="3">ABC</textarea></label><pre id="ascii-result" aria-live="polite"></pre></section>
<section class="portal-card tool wide" id="pio"><div class="portal-kicker">05 / SIMULATION</div><h2>PLC Handshake Simulator</h2><p>개념 학습용 상태 모델입니다. 실제 PLC 제어 규격, 안전 인터록, 타임아웃 시간은 설비별로 검증해야 합니다.</p><div id="signals" class="signal-grid" aria-label="신호 상태"></div><pre id="pio-result" aria-live="polite"></pre><div class="tool-links"><button type="button" class="portal-button primary" id="pio-next">Next step →</button><button type="button" class="portal-button" id="pio-fault">Timeout 발생</button><button type="button" class="portal-button" id="pio-reset">Reset (모의)</button></div></section>
</div></div>
</Portal>
<style>
.tool-links{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0 24px}.tool-links a{padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:var(--surface);font-size:14px}.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.tool{min-width:0;scroll-margin-top:24px}.tool:hover{border-color:var(--line)}.tool h2{font-size:23px;margin-top:8px}.tool label{display:grid;gap:6px;min-width:0;font-size:14px;font-weight:600;margin-block:10px}.tool input,.tool select,.tool textarea{width:100%;min-width:0;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:10px;font:inherit}.fields{display:flex;gap:10px}.fields label{flex:1}.tool pre{background:var(--soft);color:var(--fg);padding:16px;border-radius:8px;white-space:pre-wrap;overflow-wrap:anywhere;min-height:48px;font:14px/1.7 monospace}.bit-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px}.bit-grid :global(button){border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);padding:8px 0;font:12px monospace;cursor:pointer}.bit-grid :global(button[aria-pressed=true]){background:#5145d8;color:#fff}.signal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.signal-grid :global(span){border:1px solid var(--line);padding:16px 8px;text-align:center;border-radius:8px;font:14px monospace}.signal-grid :global(.signal-on){background:#14532d;color:#fff;border-color:#14532d}.wide{grid-column:1/-1}.tool button{font:inherit;cursor:pointer}.tool button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:750px){.tool-grid{grid-template-columns:1fr}.tool{padding:16px}.signal-grid{gap:5px}.signal-grid :global(span){font-size:11px}}
</style>
<script>
import {convertRadix,analyzeWord,toggleBit,formatBbl,convertAscii,handshake} from '../../lib/developer-tools.mjs';
const el=(id:string)=>document.getElementById(id)!;
const value=(id:string)=>(el(id) as HTMLInputElement).value;
const render=(id:string,fn:()=>string)=>{try{el(id).textContent=fn()}catch(e){el(id).textContent=e instanceof Error?e.message:'입력 오류'}};
const hex=()=>render('hex-result',()=>{const r=convertRadix(value('hex-value'),+value('hex-base'));return 'DEC  '+r.decimal+'\nHEX  0x'+r.hex+'\nBIN  '+r.binary});
const word=()=>{const bits=el('bits');bits.replaceChildren();render('word-result',()=>{const width=+value('word-width'),base=+value('word-base'),r=analyzeWord(value('word-value'),base,width);for(let i=width-1;i>=0;i--){const b=document.createElement('button');b.type='button';const on=r.binary[width-1-i]==='1';b.textContent=i+':'+(on?'1':'0');b.setAttribute('aria-label','Bit '+i);b.setAttribute('aria-pressed',String(on));b.addEventListener('click',()=>{const next=toggleBit(value('word-value'),base,width,i);(el('word-value') as HTMLInputElement).value=BigInt(next).toString(base).toUpperCase();word();(el('bits').children[width-1-i] as HTMLButtonElement)?.focus()});bits.append(b)}return 'Unsigned  '+r.unsigned+'\nSigned    '+r.signed+'\nHEX       '+r.hex+'\nBIN       '+r.binary})};
const bbl=()=>render('bbl-result',()=>formatBbl(value('bank'),value('bay'),value('level')));
const ascii=()=>render('ascii-result',()=>convertAscii(value('ascii-value'),value('ascii-mode')));
let state='idle';const descriptions:Record<string,string>={idle:'IDLE · 요청 대기',request:'REQUEST · 작업 요청',ack:'ACK · 요청 수신 확인',complete:'COMPLETE · 작업 완료',requestOff:'REQUEST OFF · 요청 해제',ackOff:'ACK OFF · 응답 해제',fault:'FAULT · 타임아웃 발생, 모의 리셋 필요'};
function pio(){const active:Record<string,boolean[]>={idle:[false,false,false],request:[true,false,false],ack:[true,true,false],complete:[true,true,true],requestOff:[false,true,true],ackOff:[false,false,true],fault:[false,false,false]};el('signals').replaceChildren();['REQUEST','ACK','COMPLETE'].forEach((name,i)=>{const s=document.createElement('span');const on=active[state][i];s.textContent=name+' '+(state==='fault'?'UNKNOWN':on?'ON':'OFF');s.className=on?'signal-on':'';el('signals').append(s)});el('pio-result').textContent=descriptions[state];(el('pio-next') as HTMLButtonElement).disabled=state==='fault';(el('pio-fault') as HTMLButtonElement).disabled=state==='idle'||state==='fault'}
[['hex-base','hex-value'],['word-width','word-base','word-value'],['bank','bay','level'],['ascii-mode','ascii-value']].forEach((ids,i)=>ids.forEach(id=>{el(id).addEventListener('input',[hex,word,bbl,ascii][i])}));
['next','fault','reset'].forEach((id,i)=>el('pio-'+id).addEventListener('click',()=>{state=handshake(state,['next','timeout','reset'][i]);pio()}));
hex();word();bbl();ascii();pio();
</script>